PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
APP_BASE_PATH=

# mock or google
SERVER_DATA_MODE=mock

# Required only when SERVER_DATA_MODE=google
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Required for live Core Web Vitals / CrUX lookups used by perfMatrix endpoints
CRUX_API_KEY=

# Required for Grover security-trends lookups used by the security feature charts
X_API_KEY=

# Required only for NetStorage / GSAP runtime access
# Docker can inject these at container startup instead of baking secrets into the image.
NS_HOSTNAME=
NS_KEYNAME=
NS_KEY=
NS_CP_CODE=
NS_BASE_PATH=

GOOGLE_SHEETS_SUMMARY_METRICS_RANGE=SummaryMetrics!A:E
GOOGLE_SHEETS_ACCOUNTS_RANGE=Accounts!A:I
GOOGLE_SHEETS_SUMMARY_PANELS_RANGE=SummaryPanels!A:F
GOOGLE_SHEETS_ACCOUNT_DETAILS_RANGE=AccountDetails!A:D
GOOGLE_SHEETS_ACCOUNT_HERO_METRICS_RANGE=AccountHeroMetrics!A:F
GOOGLE_SHEETS_ACCOUNT_HIGHLIGHTS_RANGE=AccountHighlights!A:F
GOOGLE_SHEETS_ACCOUNT_ACTIONS_RANGE=AccountActions!A:F
GOOGLE_SHEETS_ACCOUNT_PILLARS_RANGE=AccountPillars!A:H

# Akamai PoC hostname coverage settings
# EDGE_RC_PATH defaults to ~/.edgerc when omitted
EDGE_RC_PATH=
EDGE_RC_SECTION=default
AKAMAI_ACCOUNT_MAP_PATH=backend/account_id_map.json
